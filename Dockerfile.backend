# Base image matching your Pytest environment
FROM python:3.12-slim

# Set environment variables for optimized Python execution
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set the working directory
WORKDIR /app

# Install system dependencies (Updated for Debian Trixie/Bookworm)
RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Download spaCy English NLP model
RUN python -m spacy download en_core_web_sm

# Copy the backend source code preserving the 'backend' directory structure
COPY ./backend ./backend

# Create necessary storage directories for uploads and PDF reports
RUN mkdir -p /app/backend/storage/uploads /app/backend/storage/reports /app/data/uploads

# Expose the FastAPI port
EXPOSE 8000

# Command to run the Uvicorn server
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]